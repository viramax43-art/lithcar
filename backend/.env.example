DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/lithcar
REDIS_URL=redis://localhost:6379
SECRET_KEY=change-me-in-production
BOT_TOKEN=telegram-bot-token
TELEGRAM_BOT_POLLING_ENABLED=true
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local browser testing mode (disable in production)
ALLOW_TEST_TELEGRAM_INIT_DATA=true

# Admin key bootstrap (chief admin)
CHIEF_ADMIN_KEY=ride_chief_admin_local_key

# Local cookie mode (set true behind HTTPS in production)
ADMIN_SESSION_COOKIE_SECURE=false
DRIVER_SESSION_COOKIE_NAME=ride_driver_session
DRIVER_SESSION_TTL_HOURS=168
DRIVER_ONLINE_TTL_SECONDS=45

# Local MinIO S3 for driver photos
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=driver-photos
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# CORS for local frontend
FRONTEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,https://127.0.0.1
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=https://ride.leandoer.online
