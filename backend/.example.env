# PostgreSQL
POSTGRES_DB=lithcar
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Backend API
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/lithcar
REDIS_URL=redis://localhost:6379

# Telegram — set real values in backend/.env (never commit)
BOT_TOKEN=
TELEGRAM_BOT_POLLING_ENABLED=true

# JWT — generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Security
ENVIRONMENT=development
ALLOW_TEST_TELEGRAM_INIT_DATA=false
DEBUG=false

# CORS — comma-separated origins (no wildcard in production)
FRONTEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:5173
TELEGRAM_MINI_APP_URL=https://t.me/your_bot/ride

# Admin
CHIEF_ADMIN_KEY=
ADMIN_SESSION_COOKIE_SECURE=false

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=driver-photos
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_REQUIRED_ON_STARTUP=false

# Payments (YooKassa) — optional until configured
PAYMENT_PROVIDER=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# OSRM
OSRM_BASE_URL=https://router.project-osrm.org
